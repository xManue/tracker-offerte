# Facoltativo per avvio senza Docker. Docker Compose usa il proprio PostgreSQL.
# TRACKER_DATABASE_URL=postgresql+psycopg://tracker:password@localhost:5432/tracker

# Prezzi e costi da verificare per il proprio account. Percentuale come frazione.
# TRACKER_FEE_EBAY=0.12
# TRACKER_OUTBOUND_EBAY=9.90
# TRACKER_FEE_SUBITO=0
# TRACKER_OUTBOUND_SUBITO=0
TRACKER_EXTRA_EUR=0
TRACKER_MIN_PROFIT=25
TRACKER_ALERT_COOLDOWN_HOURS=24

# eBay Browse richiede credenziali Production e accesso abilitato.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Amazon Creators EU. Abilita solo se Amazon ha approvato l'uso per il tracker.
AMAZON_CREATORS_TRACKER_APPROVED=0
AMAZON_CREATORS_ID=
AMAZON_CREATORS_SECRET=
AMAZON_CREATORS_TAG=

# AliExpress Affiliate TOP, per app abilitate all'API di ricerca.
ALIEXPRESS_TOP_KEY=
ALIEXPRESS_TOP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Subito: ricerca salvata da web con avvisi via email. Usa una cartella dedicata.
TRACKER_MAIL_SUBITO_HOST=
TRACKER_MAIL_SUBITO_USER=
TRACKER_MAIL_SUBITO_PASSWORD=
TRACKER_MAIL_SUBITO_FOLDER=
TRACKER_MAIL_SUBITO_SENDER=

# URL di feed JSON autorizzati. Stesso schema per ogni marketplace o provider.
# TRACKER_FEED_SUBITO_URL=https://feeds.example.test/subito
# TRACKER_FEED_SUBITO_TOKEN=
# TRACKER_FEED_VINTED_URL=
# TRACKER_FEED_AMAZON_URL=
# TRACKER_FEED_ALIEXPRESS_URL=
# TRACKER_FEED_EBAY_URL=
# TRACKER_FEED_WALLAPOP_URL=
# TRACKER_FEED_FACEBOOK_URL=
# TRACKER_FEED_SOLDGRAPH_URL=
# TRACKER_FEED_SOLDGRAPH_KIND=sale
# TRACKER_FEED_SOLDGRAPH_TOKEN=

TRACKER_TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
