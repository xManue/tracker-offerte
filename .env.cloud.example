# Copia in .env.cloud. Usa la stringa Connect di Supabase con la password codificata nell’URL.
# Da una VM IPv4 scegli Session pooler sulla porta 5432.
TRACKER_DATABASE_URL='postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=data/supabase-ca.crt'
TRACKER_DATABASE_SCHEMA=tracker

# Dopo il primo avvio manuale sulla VM, scegli unless-stopped per riprendere dopo un riavvio.
TRACKER_CLOUD_RESTART_POLICY=no

# Il worker sulla VM usa i connettori configurati in questo file.
TRACKER_TAVILY_API_KEY=
TRACKER_TAVILY_SOURCES=ebay,subito,vinted,amazon,aliexpress,wallapop,facebook
TRACKER_CODEX_DISCOVERY=0
# Imposta a 1 quando usi tracker codex-bridge dal PC.
TRACKER_CODEX_BRIDGE=0
